  "templateType": "workspace",
  "templatePath": "templates",
  "features": {
    "aiprof": {},
    "workspace": {
      "files": [],
      "templates": [
        {
          "src": "templates/.cfsconfig.eta",
          "dst": ".cfs/${context.workspaceName}.cfsconfig"
        }
      ]
    }
  }
}
