{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "print-success",
      "label": "Build",
      "group": "build",
      "options": {
        "env": {
          "TASK_LABEL": "Build"
        },
        "shell": {
          "executable": "${env:CFS_TEST_NODE_PATH}",
          "args": ["task-runner.cjs"]
        }
      }
    },
    {
      "type": "shell",
      "command": "make build",
      "label": "Compile",
      "group": "build",
      "options": {
        "shell": {
          "executable": "${env:CFS_TEST_NODE_PATH}",
          "args": ["task-runner.cjs"]
        }
      }
    },
    {
      "type": "shell",
      "command": "make clean",
      "label": "Clean",
      "group": "build",
      "options": {
        "shell": {
          "executable": "${env:CFS_TEST_NODE_PATH}",
          "args": ["task-runner.cjs"]
        }
      }
    },
    {
      "type": "shell",
      "command": "make test",
      "label": "Test",
      "group": "test",
      "options": {
        "shell": {
          "executable": "${env:CFS_TEST_NODE_PATH}",
          "args": ["task-runner.cjs"]
        }
      }
    },
    {
      "type": "shell",
      "command": "capture",
      "label": "Capture Variables",
      "group": "test",
      "options": {
        "env": {
          "TASK_LABEL": "Capture Variables",
          "TASK_OUTPUT_FILE": "capture-output.json",
          "RESOLVED_CONFIG": "${config:mock.task.config}",
          "RESOLVED_ENV": "${env:CFS_TEST_ENV_VALUE}",
          "RESOLVED_FOLDER": "${workspaceFolderBasename}",
          "RESOLVED_HOME": "${userHome}",
          "RESOLVED_SEPARATOR": "${pathSeparator}"
        },
        "shell": {
          "executable": "${env:CFS_TEST_NODE_PATH}",
          "args": ["task-runner.cjs"]
        }
      }
    },
    {
      "type": "shell",
      "command": "print-success",
      "label": "Build with Dependency",
      "group": "build",
      "dependsOn": ["Build from Dependency"],
      "options": {
        "env": {
          "TASK_LABEL": "Build with Dependency"
        },
        "shell": {
          "executable": "${env:CFS_TEST_NODE_PATH}",
          "args": ["task-runner.cjs"]
        }
      }
    },
    {
      "type": "shell",
      "command": "print-success",
      "label": "Build from Dependency",
      "group": "build",
      "options": {
        "env": {
          "TASK_LABEL": "Build from Dependency"
        },
        "shell": {
          "executable": "${env:CFS_TEST_NODE_PATH}",
          "args": ["task-runner.cjs"]
        }
      }
    },
    {
      "type": "shell",
      "command": "print-both",
      "label": "Print_Both_Streams",
      "group": "build",
      "options": {
        "env": {
          "TASK_LABEL": "Print_Both_Streams"
        },
        "shell": {
          "executable": "${env:CFS_TEST_NODE_PATH}",
          "args": ["task-runner.cjs"]
        }
      }
    },
    {
      "type": "shell",
      "command": "hang",
      "label": "Hang_Task",
      "group": "build",
      "options": {
        "env": {
          "TASK_LABEL": "Hang_Task"
        },
        "shell": {
          "executable": "${env:CFS_TEST_NODE_PATH}",
          "args": ["task-runner.cjs"]
        }
      }
    },
    {
      "type": "shell",
      "command": "print-success",
      "label": "flash_run_JLink",
      "group": "build",
      "options": {
        "env": {
          "TASK_LABEL": "flash_run_JLink"
        },
        "shell": {
          "executable": "${env:CFS_TEST_NODE_PATH}",
          "args": ["task-runner.cjs"]
        }
      }
    }
  ]
}
