{
  "name": "cfs-ccm-lib",
  "description": "Client library for CodeFusion Studio's Cloud Catalog Management Service",
  "version": "2.4.0",
  "engines": {
    "node": ">=22"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "node": "./dist/mocks/index.js"
    }
  },
  "type": "module",
  "files": [
    "/dist",
    "!tsconfig.tsbuildinfo"
  ],
  "workspaces": [
    "cfs-ccm-api"
  ],
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/express": "^5.0.1",
    "@types/lodash": "^4.17.20",
    "@types/lowdb": "^1.0.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "@types/semver": "^7.5.8",
    "@types/sinon": "^21.0.0",
    "@types/temp": "^0.9.4",
    "@types/yargs": "^17.0.35",
    "c8": "^10.1.3",
    "cfs-types": "workspace:^",
    "chai": "^5.3.1",
    "chai-as-promised": "^8.0.1",
    "mocha": "^11.7.1",
    "nock": "^14.0.10",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "shx": "^0.4.0",
    "sinon": "^21.0.0",
    "tsx": "^4.20.4",
    "typescript": "catalog:",
    "yargs": "^18.0.0"
  },
  "dependencies": {
    "cfs-ccm-api": "workspace:*",
    "env-paths": "^3.0.0",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lowdb": "^7.0.1",
    "node-fetch-cache": "^5.1.0",
    "open": "^10.2.0",
    "openapi-fetch": "^0.14.0",
    "openid-client": "^6.6.4",
    "semver": "^7.7.2",
    "temp": "^0.9.4",
    "zod": "^3.25.76"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "shx rm -rf dist \"./**tsconfig.tsbuildinfo\"",
    "export:catalog": "tsx \"scripts/export-catalog/index.ts\"",
    "format-check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format-write": "oxfmt --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "npm run lint:cmd -- .",
    "lint:cmd": "oxlint --max-warnings 5",
    "lint:fix": "npm run lint -- --fix",
    "prepack": "npm run clean && npm run build",
    "pretest": "tsc --noEmit",
    "test": "c8 mocha \"test/**/*.test.ts\" --reporter-option output=coverage/test-results.json"
  }
}
