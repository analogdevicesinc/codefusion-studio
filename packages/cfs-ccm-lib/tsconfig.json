{
    "extends": "@tsconfig/node22",
    "compilerOptions": {
        "declaration": true,
        "outDir": "dist",
        "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
        "rootDir": "src",
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "allowSyntheticDefaultImports": true,
        "sourceMap": true,
        "composite": true,
        "resolveJsonModule": false,
        "module": "nodenext"
    },
    "include": ["src/**/*"],
    "references": [{ "path": "./cfs-ccm-api" }]
}
