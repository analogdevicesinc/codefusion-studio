{
	"$schema": "../../node_modules/oxlint/configuration_schema.json",
	"extends": ["../../.oxlintrc.json"],
	"plugins": [],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"node": true,
		"es2022": true
	},
	"rules": {
		"typescript/no-namespace": "off",
		"no-case-declarations": "off"
	},
	"ignorePatterns": ["dist/**"],
	"overrides": [
		{
			"files": ["**/test/**/*.test.ts"],
			"env": {
				"mocha": true
			}
		}
	]
}
