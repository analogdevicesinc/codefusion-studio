{
	"name": "cfs-types",
	"publisher": "adi",
	"description": "Shared TypeScript type definitions for CodeFusion Studio",
	"author": "Analog Devices, Inc.",
	"version": "2.4.0",
	"scripts": {
		"lint": "oxlint --max-warnings 5 .",
		"format-check": "oxfmt --check src/**/*.ts",
		"format-fix": "oxfmt --write src/**/*.ts"
	},
	"devDependencies": {
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts"
		},
		"./types/*": {
			"types": "./src/types/*.ts"
		}
	},
	"files": [
		"src",
		"package.json",
		"README.md"
	],
	"license": "Apache-2.0"
}
