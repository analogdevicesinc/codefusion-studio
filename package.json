{
	"name": "adi-cfs",
	"private": true,
	"publisher": "Analog Devices",
	"workspaces": [
		"packages/*",
		"packages/cli-plugins/*"
	],
	"type": "module",
	"scripts": {
		"typecheck": "tsc -b --noEmit --pretty false",
		"lint": "oxlint .",
		"lint:docs": "markdownlint-cli2 'docs/**/*.md'",
		"preinstall": "npx only-allow yarn",
		"auth-config": "node ./scripts/auth-config/auth-config.js",
		"skills:sync-docs": "node ./scripts/skills-docs/sync-docs.js",
		"skills:sync-docs:check": "node ./scripts/skills-docs/sync-docs.js --check",
		"ws:data-models": "yarn workspace cfs-data-models",
		"ws:ide": "yarn workspace cfs-ide",
		"ws:ui": "yarn workspace pinconfig",
		"ws:cli": "yarn workspace cfsutil",
		"ws:add-engine": "yarn workspace add-codegen",
		"ws:add-soc": "yarn workspace add-soc",
		"ws:lib": "yarn workspace cfs-lib",
		"ws:ccm-lib": "yarn workspace cfs-ccm-lib",
		"ws:react-lib": "yarn workspace cfs-react-library",
		"ws:plugins-sdk": "yarn workspace cfs-plugins-sdk",
		"ws:pkg-mgr": "yarn workspace cfs-package-manager",
		"ws:types": "yarn workspace cfs-types",
		"cfsutil": "yarn ws:cli cfsutil",
		"ui-package": "yarn ws:ui package",
		"ide-package": "yarn ws:ide package"
	},
	"devDependencies": {
		"@tsconfig/node22": "^22.0.5",
		"@types/uuid": "^11.0.0",
		"c8": "^10.1.3",
		"jszip": "^3.10.1",
		"markdownlint-cli2": "^0.13.0",
		"oxlint": "catalog:",
		"prettier": "^3.1.1",
		"prettier-config-xo": "^2.0.0",
		"puppeteer": "^23.2.2",
		"rimraf": "^5.0.5",
		"terser": "^5.39.0",
		"tsx": "^4.7.0",
		"typescript": "catalog:"
	},
	"resolutions": {
		"http-cache-semantics": "^4.3.0",
		"proxy-addr": "^2.0.8",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "yarn@4.18.0"
}
