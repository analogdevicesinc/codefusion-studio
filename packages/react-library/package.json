{
	"name": "cfs-react-library",
	"description": "Custom React components for CFS",
	"private": true,
	"version": "2.4.0",
	"type": "module",
	"scripts": {
		"build": "tsc && vite build",
		"build-dev": "vite build --mode development --watch",
		"lint": "yarn format-check && yarn oxlint",
		"oxlint": "oxlint --max-warnings 3 .",
		"stylelint": "npx stylelint \"**/src/**/*.{scss,css}\"",
		"format-check": "oxfmt --check src/**/*.{tsx,ts} .storybook/**/*.{tsx,ts} *.{ts,js,json}",
		"format-fix": "oxfmt --write src/**/*.{tsx,ts}",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"files": [
		"dist"
	],
	"types": "./dist/cfs-react-library.d.ts",
	"main": "./dist/cfs-react-library.umd.cjs",
	"module": "./dist/cfs-react-library.js",
	"exports": {
		".": {
			"import": "./dist/cfs-react-library.js",
			"require": "./dist/cfs-react-library.umd.cjs"
		}
	},
	"dependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.1",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-links": "^10.6.0",
		"@storybook/addon-onboarding": "^10.6.0",
		"@storybook/react": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@types/react": "^18.2.37",
		"@types/react-dom": "^18.2.15",
		"@typescript/typescript6": "^6.0.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vscode/webview-ui-toolkit": "^1.4.0",
		"cfs-types": "workspace:^",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"storybook": "^10.6.0",
		"stylelint": "^16.2.1",
		"stylelint-config-recess-order": "^4.4.0",
		"stylelint-config-standard": "^36.0.0",
		"stylelint-config-standard-scss": "^13.0.0",
		"typescript": "catalog:",
		"vite": "^8.2.2",
		"vite-plugin-dts": "^5.1.0",
		"vite-plugin-lib-inject-css": "^2.1.1"
	}
}
