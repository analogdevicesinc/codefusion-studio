{
	"compilerOptions": {
		"composite": true,
		"noEmit": true,
		"target": "es2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"types": ["cypress", "cypress-real-events"],
		"module": "ESNext",
		"skipLibCheck": true,
		"paths": {
			"@common/*": ["./common/*"],
			"@ide-types/*": ["../types/*"],
			"@constants/*": ["../constants/*"],
			"@west-editor/*": ["../zephyr/west-editor/*"],
			"@socs/*": ["../../../../test-fixtures/cfs-data-model/socs/*"]
		},
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": [
		"./**/*.ts",
		"./**/*.tsx",
		"./cypress.d.ts",
		"../types/**/*.ts",
		"../constants/**/*.ts",
		"../zephyr/west-editor/types.ts",
		"../zephyr/west-editor/messages.ts"
	]
}
