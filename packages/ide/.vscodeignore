# compiled UI tests (from the *:compile-tests scripts run in vscode:prepublish);
# out/commands and out/messages.js are emitted because src/tests/ui-test/tsconfig.json uses rootDir "../.."
out/tests/**
out/commands/**
out/messages.js

# build-only files of the native module closure copied by vite.plugin.copy-native-modules.ts;
# at runtime only package.json, the JS entry files, prebuilds/ and licenses are needed
out/node_modules/usb/libusb/**
out/node_modules/usb/libusb_config/**
out/node_modules/usb/src/**
out/node_modules/usb/test/**
out/node_modules/@serialport/bindings-cpp/src/**
out/node_modules/**/node-addon-api/**
out/node_modules/@types/**
out/node_modules/**/*.gyp
out/node_modules/**/*.gypi
out/node_modules/**/*.md
!out/node_modules/**/license.md

*.run
.env
.env*
**/.env
**/.env*
.vscode-test.js
.markdownlint.json
.stylelintrc.json
.prettierignore-ide
vite.config*.mts
tsconfig.*.json
